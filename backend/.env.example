# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
# IDs de Telegram con permisos globales de mantenimiento, separados por comas.
ADMIN_TELEGRAM_IDS=

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./librosync.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/librosync

# App Settings
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DEBUG=False
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0
STORAGE_DIR=./storage

# Workaround de red para ISPs que bloquean Telegram. Déjalo en False salvo necesidad.
ENABLE_NETWORK_PATCH=False

# Límites operativos
MAX_DOWNLOAD_SIZE_MB=48
DOWNLOAD_TOTAL_TIMEOUT_SECONDS=90
DOWNLOAD_PROGRESS_INTERVAL_SECONDS=8
DOWNLOAD_CACHE_TTL_SECONDS=7200
SEARCH_RATE_LIMIT=20
SEARCH_RATE_WINDOW_SECONDS=300
DOWNLOAD_RATE_LIMIT=10
DOWNLOAD_RATE_WINDOW_SECONDS=300
